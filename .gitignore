# Design documents and the build plan are the source of truth, but they live
# only on the working machine — they are updated in place (ticking off PLAN.md
# as steps land) and deliberately kept out of the repo.
#
# `/docs/*` rather than `/docs/`: git cannot re-include anything beneath an
# excluded *directory*, so the exclusion has to name the contents for the
# negation below to be reachable at all.
/docs/*
/PLAN.md

# Per-step implementation specs are a different kind of document — written once
# for one step, reviewed in the PR beside the code they describe, and never
# updated in place. They are committed.
!/docs/superpowers/

node_modules/
dist/
dist-ssr/
coverage/
*.local

# Playwright output. The specs are committed; traces and screenshots are not.
/test-results/
/playwright-report/
/blob-report/
/.playwright/

.DS_Store
.vite/
*.tsbuildinfo

.env
.env.*
!.env.example

.idea/
.vscode/*
!.vscode/extensions.json

.worktrees/
.superpowers/
